<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Calendar.SubjectsPopup">
    <VerticalStackLayout Padding="20" BackgroundColor="White">
        <Label Text="Select a Subject" FontSize="20" />
        <CollectionView ItemsSource="{Binding Subjects}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding Name}" 
                            Clicked="SubjectSelected"
                            CommandParameter="{Binding}">
                        <Button.BackgroundColor>
                            <Binding Path="ButtonColor" />
                        </Button.BackgroundColor>
                    </Button>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</toolkit:Popup>