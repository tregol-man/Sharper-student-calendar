<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Calendar.SubjectsPopup">
    <VerticalStackLayout Padding="20" BackgroundColor="White">
        <Label Text="Select a Subject" FontSize="20" FontFamily="Inter" TextColor="#4F5171" FontAttributes="Bold" Margin="0,0,0,10"/>
        <CollectionView ItemsSource="{Binding Subjects}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#4F5171">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <Button Text="{Binding Name}" Clicked="SubjectSelected" CommandParameter="{Binding}" Background="Transparent"
                                FontFamily="Inter"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="18"
                                />
                    </Border>
                    
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</toolkit:Popup>