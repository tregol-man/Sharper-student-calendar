<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calendar.LoginPage"
             Title="LoginPage">
    <ContentPage.Background>

        <LinearGradientBrush EndPoint="0,1">
            <GradientStop Color="white"
                      Offset="0" />
            <GradientStop Color="#8587DE"
                      Offset="1" />
        </LinearGradientBrush>

    </ContentPage.Background>
    <VerticalStackLayout
        Padding="20, 0">
        <Label 
            Text="Login"
            TextColor="#4F5171"
            FontFamily="Inter"
            FontSize="32"
            FontAttributes="Bold"
            VerticalOptions="Center" 
            HorizontalOptions="Start"
            Margin="0,300,0,30"/>
        <Border
            BackgroundColor="White"
            VerticalOptions="Center"
            >

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>

            <Button x:Name="GoogleLogin"
                    ImageSource="google_icon.png"
                    HeightRequest="50"
                    Clicked="OnGoogleLoginClick"
                    Text="Continue with Google"
                    FontFamily="Inter"
                    FontAttributes="Bold"
                    TextColor="#4F5171"
                    BackgroundColor="Transparent"/>
        </Border>
        <Border BackgroundColor="White" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Button x:Name="CreateGroupButton"
            HeightRequest="50"
            Clicked="OnCreateGroupClick"
            Text="Create Group"
            FontFamily="Inter"
            FontAttributes="Bold"
            TextColor="#4F5171"
            BackgroundColor="Transparent"/>
        </Border>

        <Border BackgroundColor="White" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Button x:Name="JoinGroupButton"
            HeightRequest="50"
            Clicked="OnJoinGroupClick"
            Text="Join Group"
            FontFamily="Inter"
            FontAttributes="Bold"
            TextColor="#4F5171"
            BackgroundColor="Transparent"/>
        </Border>

        <Border BackgroundColor="White" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Button x:Name="LeaveGroupButton"
            HeightRequest="50"
            Clicked="OnLeaveGroupClick"
            Text="Leave Group"
            FontFamily="Inter"
            FontAttributes="Bold"
            TextColor="#4F5171"
            BackgroundColor="Transparent"/>
        </Border>
        <Border BackgroundColor="White" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Button x:Name="DeleteGroupButton"
            HeightRequest="50"
            Clicked="OnDeleteGroupClick"
            Text="Delete Group"
            FontFamily="Inter"
            FontAttributes="Bold"
            TextColor="#4F5171"
            BackgroundColor="Transparent"/>
        </Border>
        <Border BackgroundColor="White" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>
            <Button x:Name="CreateSubjectButton"
            HeightRequest="50"
            Clicked="OnCreateSubjectClick"
            Text="Create Subject"
            FontFamily="Inter"
            FontAttributes="Bold"
            TextColor="#4F5171"
            BackgroundColor="Transparent"/>
        </Border>
    </VerticalStackLayout>
</ContentPage>