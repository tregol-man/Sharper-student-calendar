<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calendar.DatePage"
             Title="DatePage">

    <ContentPage.Background>
        <LinearGradientBrush EndPoint="0,1">
            <GradientStop Color="white" Offset="0" />
            <GradientStop Color="#8587DE" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <StackLayout Padding="20">
        <Label x:Name="DateLabel" FontSize="24" FontAttributes="Bold" FontFamily="Inter" TextColor="#4F5171" HorizontalOptions="Center" />

        <StackLayout x:Name="EventsStackLayout" Padding="10">
        </StackLayout>
        <Border
            BackgroundColor="#4F5171"
            Padding="10"
            >

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>

            <Button x:Name="CreateEventButton"
                Text="Create event"
                ImageSource="create_plus_icon.png"
                ContentLayout="Right"
                HeightRequest="45"
                FontFamily="Inter"
                FontSize="18"
                FontAttributes="Bold"
                Clicked="CreateEventButton_Clicked"
                BackgroundColor="Transparent"/>
        </Border>

    </StackLayout>
</ContentPage>
